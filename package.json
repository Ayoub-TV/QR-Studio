{
  "name": "qr-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "QR Studio — create, manage and track dynamic QR codes.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore --project qr-studio-dev",
    "deploy": "netlify deploy --build --prod"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "firebase-admin": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-tools": "^14.19.0",
    "netlify-cli": "^27.20.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
