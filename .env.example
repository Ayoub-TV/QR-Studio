# ---------------------------------------------------------------------------
# QR Studio — variables d'environnement
#
# 1. Copiez ce fichier en `.env.local` (jamais commité).
# 2. Renseignez les valeurs de votre projet Firebase (Console Firebase →
#    Paramètres du projet → Vos applications → Configuration du SDK).
# 3. Pour tester en local sans projet Firebase, laissez
#    VITE_USE_EMULATORS=true et lancez `npm run emulators` dans un terminal.
# ---------------------------------------------------------------------------

# Configuration Firebase (frontend — ces clés sont publiques par nature)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = Auth + Firestore locaux (émulateurs). false = votre projet Firebase.
VITE_USE_EMULATORS=false

# ---------------------------------------------------------------------------
# Variables SERVEUR — à définir uniquement dans Netlify
# (Site configuration → Environment variables). Jamais dans le frontend.
# ---------------------------------------------------------------------------

# Contenu JSON complet de la clé de compte de service Firebase
# (Console Firebase → Paramètres du projet → Comptes de service → Générer une
# nouvelle clé privée). Une seule ligne, guillemets inclus.
FIREBASE_SERVICE_ACCOUNT=

# ID du projet Firebase (facultatif si FIREBASE_SERVICE_ACCOUNT est fourni)
FIREBASE_PROJECT_ID=

# Sel utilisé pour hacher l'IP + le User-Agent des visiteurs (visiteurs uniques).
# Choisissez une chaîne aléatoire longue et ne la changez pas.
SCAN_HASH_SALT=
